#!/usr/bin/env bash

if [[ ! $(command -v mmsg) ]]; then
  notify-send "Eww" "The mmsg is not available" && exit 0
fi

mmsg watch all-tags | while read -r line; do
  echo "$line" | jq -r '
.all_tags[0].tags
| map(select(.client_count > 0 or .is_active == true))
| map(
"(button :class \"workspace " +
(if .is_active then "focused" else "occupied" end) +
"\" :onclick \"mmsg dispatch view," + (.index | tostring) +
"\" \"" + (.index | tostring) + "\")"
) | join(" ")
' | while read -r widgets; do
    if [[ -z "$widgets" || "$widgets" == "" ]]; then
      echo "(box :orientation \"h\" (label :text \"--\"))"
    else
      echo "(box :class 'tag' :orientation \"h\" :space-evenly false $widgets)"
    fi
  done
done

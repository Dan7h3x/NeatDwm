;; Main Config File
;;(include "./widgets/bluetooth.yuck")
;; Listening Ports
(deflisten workspaces :initial "(box)" "bash scripts/workspaces")
(deflisten kblayout :initial "-" "bash scripts/keyboardlayout")
(defpoll client-title :interval "500ms" "scripts/client")
(defpoll time :interval "1s" `date +'{"hour":"%H","min":"%M","sec":"%S","pretty":"%a, %e %b","day":"%A","month":"%B","dom":"%e","year":"%Y","day_num":"%d","month_num":"%m","year_num":"%y"}'`)


;; Main Bar Window
(defwindow mainbar
           :monitor 0
           :windowtype "dock"
           :geometry (geometry
                      :x "0%"
                      :y "0%"
                      :width "90%"
                      :height "25px"
                      :anchor "top center")
           :stacking "fg"
           :exclusive true
           :reverse (struts :side "top" :distance "25px")
           :wm-ignore false
           :class "mainbar"
           (mainbar_widget))

;; Main Bar Widget
(defwidget mainbar_widget []
           (centerbox :class "mainbar_widget"
                      (box :class "left-module"
                           :orientation "h"
                           :space-evenly false
                           :halign "start"
                           :spacing 2
                           (literal :content workspaces))
                      (box :class "center-module"

                           :orientation "h"
                           :space-evenly false
                           :halign "center"
                           :spacing 2
                           (title)
                           )
                      (box :class "right-module"

                           :orientation "h"
                           :space-evenly false
                           :halign "end"
                           :spacing 2
                           (kb-layout)
                           (system-tray)
                           (timecal)
                           )

))

(defwidget title []
           (box :class "client-title"
           :space-evenly false
(image :path "./icons/board.svg"
               :image-width 20
               :image-height 20)
                (label :text "${client-title}"
                       :limit-width 50
                       :show-truncated true))
)




(defwidget kb-layout []
(box :orientation "h"
      :class "kb-layout"
          (label :text "${kblayout}"))
)

(defwidget timecal []
(box :class "time-bar"
           :orientation "h"
           :space-evenly false
           :spacing 0
           :valign "center"
           :vexpand false
           (image :path "./icons/calendar.svg" :image-width 20
               :image-height 20)
        (label :class "time-text"
               :valign "center"
               :vexpand false
               :text "${time.hour}:${time.min}:${time.sec}")
      )
)

(defwidget system-tray []
  (box
        :orientation "h"
        :class "system-tray"
       :spacing 1
       :space-evenly false
    (systray :space-evenly false :spacing 3 :orientation "h" :class "inside-tray")
  )
)

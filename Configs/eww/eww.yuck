;; Main Config File
;;(include "./widgets/bluetooth.yuck")
;; Listening Ports
(deflisten workspaces :initial "(box)" "scripts/workspaces")
(deflisten kblayout :initial "" "scripts/keyboardlayout")
(defpoll client-title :interval "500ms" "scripts/client")

;; Main Bar Window
(defwindow mainbar
           :monitor 0
           :windowtype "dock"
           :geometry (geometry
                      :x "0%"
                      :y "0%"
                      :width "90%"
                      :height "25px"
                      :anchor "top center")
           :stacking "fg"
           :exclusive true
           :reverse (struts :side "top" :distance "25px")
           :wm-ignore false
           :class "mainbar"
           (mainbar_widget))

;; Main Bar Widget
(defwidget mainbar_widget []
           (centerbox :class "mainbar_widget"
                      (box :class "left-module"
                           :orientation "h"
                           :space-evenly false
                           :halign "start"
                           :spacing 2
                           (literal :content workspaces))
                      (box :class "center-module"

                           :orientation "h"
                           :space-evenly false
                           :halign "center"
                           :spacing 2
                           (title))
                      (box :class "right-module"

                           :orientation "h"
                           :space-evenly false
                           :halign "end"
                           :spacing 2
                           (label :text "Hello")
                           (system-tray)
                           (kblayout))

))

(defwidget title []
           (box :class "client-title"
                (label :text "🖥️${client-title}"
                       :limit-width 40
                       :spacing 2
                       :show-truncated true))
)

(defwidget system-tray []
  (box :class "system-tray"
        :orientation "v"
        :spacing 1
        :space-evenly false
        (systray :space-evenly false :orientation "v" :class "inside-tray"))
)


(defwidget kblayout []
(box :orientation "h"
          (label :text "${kblayout}"))
)
